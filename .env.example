# ------------------------------------------------------------------------------
# Vexta Bridge V2 Environment Configuration
# ------------------------------------------------------------------------------

# Logging verbosity level (trace, debug, info, warn, error)
RUST_LOG=vexta_bridge_v2=info,tower_http=info

# Server host and port
HOST=0.0.0.0
PORT=8000

# SQLite database file path
DATABASE_PATH=vexta_bridge_v2.db

# Secret token required to access the Admin Console at /admin/ and /api/admin/*
ADMIN_SECRET_TOKEN=vexta_admin_secret_key_2026

# Public domain name (Cloudflare Tunnel target)
SERVER_DOMAIN=vexta-api.nexusec.space

# Cloudflare Tunnel Secret Token (Get from Cloudflare Zero Trust Dashboard -> Tunnels)
TUNNEL_TOKEN=your_cloudflare_tunnel_token_here

# CORS allowed origins (comma-separated, includes React admin dev server at :5173)
ALLOWED_ORIGINS=https://vexta.nexusec.space,https://vexta-api.nexusec.space,http://localhost:1420,http://localhost:5173,http://localhost:8000
